{
  "name": "physio-clinic-app",
  "version": "1.0.0",
  "description": "Local-first physiotherapist clinic desktop application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.physioclinic.suite",
    "productName": "PhysioClinic Suite",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhysioClinic Suite",
      "runAfterFinish": true
    }
  },
  "keywords": [
    "electron",
    "physiotherapy",
    "clinic",
    "local-first"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
